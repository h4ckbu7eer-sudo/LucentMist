# LucentMist 环境变量示例，复制为 .env 后按需修改
LMIST_LLM_PROVIDER=ollama
LMIST_LLM_MODEL=qwen2.5:7b
LMIST_LLM_ENDPOINT=http://localhost:11434
LMIST_LLM_APIKEY=

LMIST_API_TOKEN=
LMIST_DB=data/lucentmist.db
LMIST_BIND_ADDRESS=127.0.0.1
LMIST_LOG_FILE=logs/lucentmist.log
LMIST_CORS_ORIGINS=
LMIST_RATE_LIMIT_RPS=10
LMIST_RATE_LIMIT_BURST=20
LMIST_MAX_CONNECTIONS=512
LMIST_RETENTION_DAYS=90
LMIST_CLEANUP_HOURS=24
LMIST_DB_VACUUM=0
LMIST_DB_MAINTENANCE_OWNER=both

LMIST_WEB_BIND=127.0.0.1
LMIST_WEB_USER=
LMIST_WEB_PASSWORD=
LMIST_API_URL=http://localhost:5050

# 漏洞扫描默认查询免费云源；只发送服务/产品/CPE，不发送目标 IP 或完整 banner。
# 离线使用必须显式设为 false。Shodan CVEDB 免费许可仅限非商业使用。
LMIST_CVE_EXTERNAL=true
LMIST_CVE_DB_PATH=
LMIST_CVE_DEBUG=false
