<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LucentMist.CLI</RootNamespace>
    <AssemblyName>lmist</AssemblyName>
    <RollForward>LatestMajor</RollForward>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>lmist</ToolCommandName>
    <PackageId>LucentMist.CLI</PackageId>
    <Description>LucentMist command-line network analysis assistant.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LucentMist.Tools.Tests" />
    <InternalsVisibleTo Include="LucentMist.CLI.TestHost" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LucentMist.Agent\LucentMist.Agent.csproj" />
    <ProjectReference Include="..\LucentMist.Scanning\LucentMist.Scanning.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="Spectre.Console" />
  </ItemGroup>

</Project>
