@page "/"
@implements IAsyncDisposable
@using System.Net.Http
@using System.Text.Json
@using System.Net.Http.Json
@using LucentMist.Scanning
@inject AppState State
@inject ScanTaskClient ScanTask
@inject IHttpClientFactory HttpFactory

<PageTitle>LucentMist — 仪表板</PageTitle>
<div class="page-header">
    <h2>📊 仪表板</h2>
    <span style="color: var(--text-muted);">@DateTime.Now.ToString("yyyy-MM-dd HH:mm")</span>
</div>

<div class="card-grid">
    <div class="card">
        <div class="card-title">在线设备</div>
        <div class="card-value green">@State.OnlineDevices</div>
    </div>
    <div class="card">
        <div class="card-title">扫描次数</div>
        <div class="card-value">@State.ScanCount</div>
    </div>
    <div class="card">
        <div class="card-title">引擎</div>
        <div class="card-value" style="font-size:1rem;color:var(--green);">@State.LlmProvider</div>
    </div>
    <div class="card">
        <div class="card-title">版本</div>
        <div class="card-value" style="font-size:1rem;">v@(LucentMist.Core.AppVersion.Current)</div>
    </div>
</div>

<div class="card">
    <div class="card-title">快速扫描</div>
    <div style="display:flex;gap:0.5rem;margin-top:0.5rem;">
        <input type="text" @bind="_target" placeholder="127.0.0.1" style="flex:1" />
        <button class="btn btn-primary" @onclick="QuickScan" disabled="@_busy">@(_busy ? "扫描中..." : "🔍 扫描")</button>
    </div>
</div>

@if (!string.IsNullOrEmpty(State.CurrentTaskId))
{
    <div class="card">
        <div class="card-title">任务 @State.CurrentTaskId[..8]</div>
        <div>@State.CurrentStatus — @State.CurrentMessage</div>
        <div style="height:8px;background:var(--border);border-radius:4px;overflow:hidden;margin-top:0.5rem;">
            <div style="height:100%;width:@(State.ProgressPercent)%;background:var(--green);transition:width .2s;"></div>
        </div>
    </div>
}

@if (State.LastError != null)
{
    <div class="card"><div style="color:var(--red);font-weight:600;">@State.LastError</div></div>
}

@if (State.LastResults.Count > 0)
{
    <div class="card">
    <table><thead><tr><th>IP</th><th>开放端口</th></tr></thead><tbody>
    @foreach (var r in State.LastResults)
    {
        <tr><td><span class="status-dot online"></span> @r.Ip</td><td>@r.Ports</td></tr>
    }
    </tbody></table>
    </div>
}

@code {
    private string _target = "127.0.0.1";
    private bool _busy;
    private Action<ScanTaskRecord>? _completedHandler;
    private Action<string>? _failedHandler;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var client = HttpFactory.CreateClient("AgentApi");
            var cfg = await client.GetFromJsonAsync<JsonElement>("/api/v1/config");
            if (cfg.TryGetProperty("llm", out var llm) &&
                llm.TryGetProperty("provider", out var provider))
                State.LlmProvider = provider.GetString() ?? "ReAct + LLM";
        }
        catch
        {
            // 配置读取失败时保留中性显示，不阻塞页面。
        }

        ScanTask.Progress += OnProgress;
        _completedHandler = rec => _ = OnCompletedAsync(rec);
        _failedHandler = error => _ = OnFailedAsync(error);
        ScanTask.Completed += _completedHandler;
        ScanTask.Failed += _failedHandler;
    }

    private async Task QuickScan()
    {
        _busy = true;
        State.LastResults.Clear();
        State.LastError = null;
        State.CurrentTaskId = "";
        try
        {
            await ScanTask.StartAsync(_target, "ping", "");
            State.CurrentTaskId = ScanTask.TaskId;
            State.CurrentStatus = "pending";
            State.CurrentMessage = "等待队列";
            State.ProgressPercent = 0;
        }
        catch (Exception ex)
        {
            State.LastError = ex.Message;
            _busy = false;
        }
    }

    private void OnProgress(ScanProgressEvent evt)
    {
        State.CurrentStatus = evt.Status;
        State.CurrentMessage = evt.Message;
        State.ProgressPercent = evt.Percent;
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task OnCompletedAsync(ScanTaskRecord rec)
    {
        try
        {
            _busy = false;
            State.CurrentStatus = "completed";
            State.CurrentMessage = "完成";
            State.ProgressPercent = 100;
            State.LastError = null;
            ApplyResult(rec);
            State.ScanCount++;
            State.LastScanTarget = rec.Target;
        }
        catch (Exception ex)
        {
            State.LastError = ex.Message;
        }
        finally
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OnFailedAsync(string error)
    {
        try
        {
            _busy = false;
            State.CurrentStatus = "failed";
            State.CurrentMessage = "失败";
            State.ProgressPercent = 100;
            State.LastError = error;
        }
        finally
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private void ApplyResult(ScanTaskRecord rec)
    {
        State.LastResults.Clear();
        if (string.IsNullOrWhiteSpace(rec.ResultJson)) return;

        using var doc = JsonDocument.Parse(rec.ResultJson);
        var root = doc.RootElement;
        State.OnlineDevices = root.TryGetProperty("alive", out var alive) ? alive.GetInt32() : 0;

        var byIp = root.TryGetProperty("openPortsByIp", out var portsByIp)
            ? portsByIp.EnumerateObject().ToDictionary(x => x.Name, x => x.Value)
            : new Dictionary<string, JsonElement>();

        if (root.TryGetProperty("devices", out var devices))
        {
            foreach (var ip in devices.EnumerateArray())
            {
                var value = ip.GetString();
                if (string.IsNullOrEmpty(value)) continue;

                var ports = byIp.TryGetValue(value, out var entry)
                    ? entry.EnumerateArray().Select(p => p.GetInt32()).ToArray()
                    : [];
                State.LastResults.Add(new(value, ports.Length > 0 ? string.Join(",", ports) : "无"));
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        ScanTask.Progress -= OnProgress;
        if (_completedHandler != null) ScanTask.Completed -= _completedHandler;
        if (_failedHandler != null) ScanTask.Failed -= _failedHandler;
        await ScanTask.DisposeAsync();
    }
}
