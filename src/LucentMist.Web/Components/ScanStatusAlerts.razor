@implements IDisposable

@if (!string.IsNullOrWhiteSpace(Client.MonitoringError))
{
    <div class="card" role="status" style="margin-bottom:1rem;border-color:#f59e0b;background:rgba(245,158,11,.08);">
        <div style="color:#f59e0b;font-weight:700;">⚠️ 监控状态</div>
        <div>@Client.MonitoringError</div>
        @if (Client.CurrentStatus == "monitoring_unavailable")
        {
            <div style="margin-top:0.5rem;">
                <a href="/scan/history" style="color:#fbbf24;font-weight:700;">查看扫描历史 →</a>
            </div>
        }
    </div>
}

@if (!string.IsNullOrWhiteSpace(Client.LastError))
{
    <div class="card" role="alert" style="margin-bottom:1rem;">
        <div style="color:var(--red);font-weight:600;">@Client.LastError</div>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public ScanTaskClient Client { get; set; } = null!;

    protected override void OnInitialized() =>
        Client.MonitoringStateChanged += OnMonitoringStateChanged;

    private void OnMonitoringStateChanged() =>
        _ = InvokeAsync(StateHasChanged);

    public void Dispose() =>
        Client.MonitoringStateChanged -= OnMonitoringStateChanged;
}
