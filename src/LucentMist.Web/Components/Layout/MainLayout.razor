@inherits LayoutComponentBase
@inject AppState State
@inject IHttpClientFactory HttpFactory

<div class="app">
    <nav class="sidebar">
        <div class="sidebar-brand">
            <span class="brand-icon">🌫️</span>
            <span class="brand-text">LucentMist</span>
            <span class="badge">v@(LucentMist.Core.AppVersion.Current)</span>
        </div>
        <NavLink class="nav-item" href="" Match="NavLinkMatch.All">
            <span class="nav-icon">📊</span> 仪表板
        </NavLink>
        <NavLink class="nav-item" href="/devices">
            <span class="nav-icon">🖥️</span> 设备列表
        </NavLink>
        <NavLink class="nav-item" href="/scan">
            <span class="nav-icon">🔍</span> 扫描控制
        </NavLink>
        <NavLink class="nav-item" href="/scan/history">
            <span class="nav-icon">📜</span> 扫描历史
        </NavLink>
        <NavLink class="nav-item" href="/agent">
            <span class="nav-icon">🤖</span> Agent 对话
        </NavLink>
        <NavLink class="nav-item" href="/ssl-check">
            <span class="nav-icon">🔒</span> SSL 证书
        </NavLink>
        <div class="sidebar-footer">
            <span>LucentMist + @_provider</span>
        </div>
    </nav>
    <main class="content">
        @Body
    </main>
</div>

@code {
    private string _provider = "Ollama";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var client = HttpFactory.CreateClient("AgentApi");
            var cfg = await client.GetFromJsonAsync<System.Text.Json.JsonElement>("/api/v1/config");
            if (cfg.TryGetProperty("llm", out var llm) &&
                llm.TryGetProperty("provider", out var provider))
            {
                _provider = provider.GetString() ?? "Ollama";
                State.LlmProvider = _provider;
            }
        }
        catch
        {
            // API 不可达时保留默认值，不阻塞页面。
        }
    }
}
